def parse(argv):
    cmd = argv[0] if argv and argv[0] in ('check', 'list', 'ack', 'init', 'fetch') else 'check'
    rest = argv[1:] if argv and argv[0] == cmd else argv
    o = dict(cmd=cmd, names=[], top=False, tags=[], verbose=False, json=False, notify=False, quiet=False, wait=0,
             fetch=False, fopt=dict(FETCH_DEFAULTS), fset=[])
    it = iter(rest)

    def num(opt, kind=float):
        v = next(it, None)
        try:
            return kind(v)
        except (TypeError, ValueError):
            fetch_die(f'{opt} needs a number; see upwatch --help')

    def word(opt):
        v = next(it, None)
        if v is None:
            fetch_die(f'{opt} needs a value; see upwatch --help')
        return v
    for a in it:
        if a in ('-h', '--help'):
            print(__doc__); sys.exit(0)
        elif a == '--top': o['top'] = True
        elif a == '--all': o['top'] = False
        elif a == '--games': o['tags'].append('game')
        elif a == '--tag': o['tags'].append(next(it, ''))
        elif a.startswith('--tag='): o['tags'].append(a[6:])
        elif a in ('-v', '--verbose'): o['verbose'] = True
        elif a == '--json': o['json'] = True
        elif a == '--fetch': o['fetch'] = True
        elif a in ('--dry-run', '--yes'): o['fopt'][a[2:].replace('-', '_')] = True; o['fset'].append(a)
        elif a == '--batch': o['fopt']['batch'] = num(a, int); o['fset'].append(a)
        elif a == '--gap': o['fopt']['gap'] = [num(a), num(a)]; o['fset'].append(a)
        elif a in ('--settle', '--poll'): o['fopt'][a[2:]] = num(a); o['fset'].append(a)
        elif a in ('--downloads', '--opener', '--report', '--inbox-dir', '--archive-dir'):
            v = word(a)
            o['fopt'][a[2:].replace('-', '_')] = os.path.expanduser(v) if a != '--opener' else v
            o['fset'].append(a)
        elif a == '--notify': o['notify'] = True
        elif a in ('-q', '--quiet'): o['quiet'] = True
        elif a == '--wait-network': o['wait'] = int(next(it, '0'))
        elif a.startswith('--wait-network='): o['wait'] = int(a.split('=', 1)[1])
        elif a.startswith('-'): raise SystemExit(f'unknown option {a}; see upwatch --help')
        else: o['names'].append(a)
    f = o['fopt']
    if not 1 <= f['batch'] <= MAX_BATCH:
        fetch_die(f'--batch must be 1 to {MAX_BATCH}')
    if f['gap'][0] < 1 or f['gap'][1] < f['gap'][0]:
        fetch_die('--gap MIN MAX needs 1 <= MIN <= MAX')
    if f['settle'] < 0.5 or f['poll'] < 0.1:
        fetch_die('--settle must be at least 0.5 and --poll at least 0.1')
    return o


def main(argv):
    o = parse(argv)
    if o['cmd'] == 'init':
        if os.path.exists(CONFIG):
            raise SystemExit(f'{CONFIG} exists; not overwriting')
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        open(CONFIG, 'w').write(EXAMPLE)
        print(f'wrote {CONFIG}')
        return 0
    fetching = o['fetch'] or o['cmd'] == 'fetch'
    if o['fset'] and not fetching:
        fetch_die(f'{o["fset"][0]} is a fetch option: use it with --fetch or upwatch fetch FILE')
    if any(x in o['fset'] for x in ('--inbox-dir', '--archive-dir')) and o['cmd'] != 'fetch':
        fetch_die('--inbox-dir and --archive-dir are for upwatch fetch FILE (with --fetch, use fetch_dir in the config)')
    if fetching:        # interactive only: a timer or a pipe must never open browser pages
        what = '--fetch' if o['cmd'] != 'fetch' else 'fetch'
        why = ('only with check' if o['cmd'] not in ('check', 'fetch') or (o['fetch'] and o['cmd'] == 'fetch')
               else 'not with --notify or --quiet' if o['notify'] or o['quiet']
               else 'not with --json' if o['json'] else 'only in a terminal' if not (sys.stdin.isatty() and sys.stdout.isatty())
               else '')
        if why:
            print(f'upwatch: {what} is {why}; nothing fetched', file=sys.stderr)
            return 2
    if o['cmd'] == 'fetch':
        if len(o['names']) != 1 or o['top'] or o['tags'] or o['wait']:
            fetch_die('usage: upwatch fetch WANTS.json [FETCH OPTIONS]')
        return fetch_wants(load_config()[0] if os.path.exists(CONFIG) else {}, o['names'][0], o)
    settings, srcs = load_config()
    if o['cmd'] == 'ack':
        if not o['names']:
            raise SystemExit('usage: upwatch ack NAME ...')
        state = load_state()
        chosen = select(srcs, o['names'], o['top'], o['tags'])
        byname = {s['name']: s for s in srcs}
        for path, name, r in run_checks(settings, chosen, state):
            if '/' in path:
                print(f'{name}: list members take their installed version from the list file; nothing to record')
                continue
            if any(k in byname[path] for k in ('installed', 'installed_glob', 'installed_cmd')):
                print(f'{name}: the installed version comes from the config ({r.get("installed")}); nothing to record')
                continue
            if r.get('error') or not r.get('latest'):
                print(f'E {name}: {r.get("error", "no version")}')
                continue
            state.setdefault('acked', {})[path] = r['latest']
            state.get('notified', {}).pop(path, None)
            print(f'{name}: {r["latest"]} recorded as yours')
        save_state(state)
        return 0
    chosen = select(srcs, o['names'], o['top'], o['tags'])
    if o['cmd'] == 'list':
        for s, mem in chosen:
            extra = s.get('repo') or s.get('file') or (f"{s.get('game', 'witcher3')}/{s.get('mod_id')}" if s['type'] == 'nexus' else '')
            print(f"{s['name']:20} {s['type'] if s['type'] != 'list' else 'list:' + s.get('format', 'nexus-check'):22} "
                  f"{','.join(s.get('tags', [])):12} {extra}")
            if isinstance(mem, Exception):
                print(f"    E reading list: {mem}")
            elif mem:
                for m in mem:
                    print(f"    {s['name']}/{m['id']:40} {m['kind']:7} {m['label']}")
        return 0
    t0 = time.time()
    if o['wait'] and not wait_network(chosen, o['wait']):
        return 0      # no network: skip quietly, the next timer run checks again
    state = load_state()
    results = run_checks(settings, chosen, state)
    if o['notify']:
        send_notifications(results, state)
    state['last_run'] = time.strftime('%Y-%m-%dT%H:%M:%S%z')
    save_state(state)
    if o['json']:
        print(json.dumps(as_json(results), indent=1))
        return 0
    shown = 0
    for path, name, r in results:
        ln = line(name, r)
        if o['verbose'] or ln[:1] in 'U!E':
            if not (o['quiet'] and ln[:1] not in 'U!E'):
                print(ln)
                shown += ln[:1] in 'U!E'
    if not shown and not o['quiet']:
        print(f'no updates ({len(results)} checked)')
    if o['verbose']:
        n, g = LIMITS.get('nexus'), LIMITS.get('github')
        if n:
            print(f'Nexus API left: {n[0]}/{n[1]} this hour, {n[2]}/{n[3]} today')
        if g:
            print(f'GitHub API left: {g[0]}/{g[1]} this hour')
        print(f'TIME {time.time() - t0:.1f} s')
    if o['fetch']:
        return fetch_updates(settings, srcs, results, o)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
